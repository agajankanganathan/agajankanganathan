{
  // Standalone config so tools outside the Expo app (e.g. the portal's Vite build)
  // can read these shared files without needing Expo installed.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./*.ts"]
}
